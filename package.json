{
	"name": "oracle-code",
	"version": "0.2.0",
	"type": "module",
	"description": "A terminal coding agent that runs against a local model. Bun or Node, Linux, macOS or Windows.",
	"bin": {
		"oc": "./src/index.ts"
	},
	"scripts": {
		"dev": "bun run src/index.ts",
		"build": "bun build --compile --minify src/index.ts --outfile dist/oc",
		"test": "bun test",
		"test:node": "tsx scripts/portability.mts",
		"bench": "bun run bench/frame.ts",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.2",
		"typescript": "^5.6.0"
	},
	"engines": {
		"bun": ">=1.1.0",
		"node": ">=20.11.0"
	}
}
